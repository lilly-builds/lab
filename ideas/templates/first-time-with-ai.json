  { "id": "r3", "type": "rect", "x": 872, "y": 90, "w": 336, "h": 376, "strokeColor": "#1e1e1e", "fill": "none", "strokeWidth": 2 },
  { "id": "r4", "type": "rect", "x": 0, "y": 566, "w": 772, "h": 250, "strokeColor": "#1e1e1e", "fill": "none", "strokeWidth": 2 },
  { "id": "z1", "type": "text", "x": 24, "y": 106, "text": "1. Say what you want", "size": 24, "color": "#1e1e1e", "w": 300 },
  { "id": "z2", "type": "text", "x": 460, "y": 106, "text": "2. Read and reply", "size": 24, "color": "#1e1e1e", "w": 300 },
  { "id": "z3", "type": "text", "x": 896, "y": 106, "text": "Easy first tries", "size": 24, "color": "#1e1e1e", "w": 300 },
  { "id": "z4", "type": "text", "x": 24, "y": 582, "text": "Type this to the AI on this board", "size": 24, "color": "#1e1e1e", "w": 724 },
  { "id": "n1", "type": "note", "x": 24, "y": 154, "w": 132, "h": 132, "text": "Type like you talk to a friend", "fill": "#bfd7ff" },
  { "id": "n2", "type": "note", "x": 180, "y": 154, "w": 132, "h": 132, "text": "Say who you are in one line", "fill": "#bfd7ff" },
  { "id": "n3", "type": "note", "x": 24, "y": 310, "w": 132, "h": 132, "text": "Say what you want back", "fill": "#bfd7ff" },
  { "id": "n4", "type": "note", "x": 180, "y": 310, "w": 132, "h": 132, "text": "Short is fine. No tricks.", "fill": "#bfd7ff" },
  { "id": "n5", "type": "note", "x": 460, "y": 154, "w": 132, "h": 132, "text": "Not right? Say what to change", "fill": "#bfd7ff" },
  { "id": "n6", "type": "note", "x": 616, "y": 154, "w": 132, "h": 132, "text": "Say: shorter, simpler, cheaper", "fill": "#bfd7ff" },
  { "id": "n7", "type": "note", "x": 460, "y": 310, "w": 132, "h": 132, "text": "Say: why did you suggest that?", "fill": "#bfd7ff" },
  { "id": "n8", "type": "note", "x": 616, "y": 310, "w": 132, "h": 132, "text": "It never gets tired of asking", "fill": "#bfd7ff" },
  { "id": "n9", "type": "note", "x": 896, "y": 154, "w": 132, "h": 132, "text": "Try: “Explain my gas bill in plain words.”", "fill": "#bfd7ff" },
  { "id": "n10", "type": "note", "x": 1052, "y": 154, "w": 132, "h": 132, "text": "Try: “Write a thank you note to my neighbour.”", "fill": "#bfd7ff" },
  { "id": "n11", "type": "note", "x": 896, "y": 310, "w": 132, "h": 132, "text": "Try: “Help me say no to a favour, kindly.”", "fill": "#bfd7ff" },
  { "id": "n12", "type": "note", "x": 1052, "y": 310, "w": 132, "h": 132, "text": "Try: “What can I cook with eggs and spinach?”", "fill": "#bfd7ff" },
  { "id": "n13", "type": "note", "x": 24, "y": 630, "w": 132, "h": 132, "text": "Your turn: ask the AI in your own words", "fill": "#bfd7ff" },
  { "id": "n14", "type": "note", "x": 180, "y": 630, "w": 132, "h": 132, "text": "Ask the AI: “Give me 3 ways to try this.”", "fill": "#bfd7ff" },
  { "id": "p1", "type": "text", "x": 360, "y": 630, "text": "Copy this exactly: “I am a nurse with two kids. Give me a simple 3 day dinner plan using chicken and rice.”", "size": 20, "color": "#1e1e1e", "w": 388 },
