  { "id": "z1", "type": "text", "x": 24, "y": 106, "text": "What happened", "size": 24, "color": "#1e1e1e", "w": 300 },
  { "id": "z2", "type": "text", "x": 460, "y": 106, "text": "What I want", "size": 24, "color": "#1e1e1e", "w": 300 },
  { "id": "z3", "type": "text", "x": 896, "y": 106, "text": "Then I say it", "size": 24, "color": "#1e1e1e", "w": 300 },
  { "id": "z4", "type": "text", "x": 24, "y": 582, "text": "Type this to the AI on this board", "size": 24, "color": "#1e1e1e", "w": 724 },
  { "id": "n1", "type": "note", "x": 24, "y": 154, "w": 132, "h": 132, "text": "My sister cancelled Mom’s birthday", "fill": "#bfd7ff" },
  { "id": "n2", "type": "note", "x": 180, "y": 154, "w": 132, "h": 132, "text": "Third time this year", "fill": "#bfd7ff" },
  { "id": "n3", "type": "note", "x": 24, "y": 310, "w": 132, "h": 132, "text": "I felt let down and said nothing", "fill": "#bfd7ff" },
  { "id": "n4", "type": "note", "x": 180, "y": 310, "w": 132, "h": 132, "text": "It is still sitting in me", "fill": "#bfd7ff" },
  { "id": "n5", "type": "note", "x": 460, "y": 154, "w": 132, "h": 132, "text": "She knows how it landed", "fill": "#bfd7ff" },
  { "id": "n6", "type": "note", "x": 616, "y": 154, "w": 132, "h": 132, "text": "A plan for the next one", "fill": "#bfd7ff" },
  { "id": "n7", "type": "note", "x": 460, "y": 310, "w": 132, "h": 132, "text": "Keep the relationship warm", "fill": "#bfd7ff" },
  { "id": "n8", "type": "note", "x": 616, "y": 310, "w": 132, "h": 132, "text": "Not to blame or win", "fill": "#bfd7ff" },
  { "id": "n9", "type": "note", "x": 896, "y": 154, "w": 132, "h": 132, "text": "Read the draft out loud first", "fill": "#bfd7ff" },
  { "id": "n10", "type": "note", "x": 1052, "y": 154, "w": 132, "h": 132, "text": "Change any word that is not me", "fill": "#bfd7ff" },
  { "id": "n11", "type": "note", "x": 896, "y": 310, "w": 132, "h": 132, "text": "Pick a calm time, not at night", "fill": "#bfd7ff" },
  { "id": "n12", "type": "note", "x": 1052, "y": 310, "w": 132, "h": 132, "text": "Send it, or call her instead", "fill": "#bfd7ff" },
  { "id": "n13", "type": "note", "x": 24, "y": 630, "w": 132, "h": 132, "text": "Ask the AI: “Write a calm text, under 80 words.”", "fill": "#bfd7ff" },
  { "id": "n14", "type": "note", "x": 180, "y": 630, "w": 132, "h": 132, "text": "Ask the AI: “Make it softer and more honest.”", "fill": "#bfd7ff" },
  { "id": "p1", "type": "text", "x": 360, "y": 630, "text": "Copy this and change the names: “My sister cancelled our mom’s birthday for the third time. I am hurt but want to stay close. Write a calm message I can send her.”", "size": 20, "color": "#1e1e1e", "w": 388 },
